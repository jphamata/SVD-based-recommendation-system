{
  "scopeName": "source.mizan",
  "name": "Al-Mizān",
  "patterns": [
    { "name": "comment.line.semicolon.mizan", "match": ";.*$" },
    { "name": "keyword.declaration.mizan", "match": "(?<=\\()\\s*(claim|import|دعوى|استيراد)(?=[\\s)])" },
    { "name": "keyword.other.clause.mizan", "match": "(?<=\\()\\s*(root|wazn|inputs|field|box|step|init|invariant|proof|body|جذر|وزن|مدخلات|حقل|صندوق|خطوة|بداية|ثابت|برهان|تنفيذ)(?=[\\s)])" },
    { "name": "entity.name.tag.root.mizan", "match": "(?<=[\\s(])(H-s-b|H-f-Z|n-q-l|k-t-b|ح-س-ب|ح-ف-ظ|ن-ق-ل|ك-ت-ب)(?=[\\s)])" },
    { "name": "storage.modifier.wazn.mizan", "match": "(?<=[\\s(])(fail|maful|burhan|فاعل|مفعول)(?=[\\s)])" },
    { "name": "support.type.mizan", "match": "(?<=[\\s(])(q|int|f64|f32|bool|نسبي|صحيح|عائم٦٤|عائم٣٢|منطقي)(?=[\\s)])" },
    { "name": "keyword.other.proof.mizan", "match": "(?<=[\\s(])(conserved|nonneg|pos|identity|bounded|محفوظ|غير-سالب|موجب|متطابقة|محدود)(?=[\\s)])" },
    { "name": "keyword.operator.logical.mizan", "match": "(?<=\\()(and|or|not|if|و|أو|ليس|إذا)(?=[\\s)])" },
    { "name": "constant.language.mizan", "match": "(?<=[\\s(])(true|false|صواب|خطأ)(?=[\\s)])" },
    { "name": "constant.numeric.mizan", "match": "(?<=[\\s(])-?[0-9٠-٩]+(?:[./][0-9٠-٩]+)?(?=[\\s)])" },
    { "name": "keyword.operator.arithmetic.mizan", "match": "(?<=\\()(\\+|-|\\*|/|\\^|<=|>=|<|>|=|جمع|طرح|ضرب|قسمة|أس)(?=[\\s)])" },
    { "name": "variable.other.arabic.mizan", "match": "@[A-Za-z'|><&}*$`{~_-]+" }
  ]
}
