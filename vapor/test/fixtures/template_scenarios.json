       "required": [
        "city",
        "days"
       ]
      }
     }
    },
    {
     "type": "function",
     "function": {
      "name": "search_docs",
      "description": "Search the corpus",
      "parameters": {
       "type": "object",
       "properties": {
        "query": {
         "type": "string"
